#!/usr/bin/env bash
# Downloads the pinned LGPL FFmpeg 8.1 shared build (BtbN/FFmpeg-Builds),
# verifies its size and SHA-256 and unpacks it (M2-01, VAL-MEDIA-004).
#
# Usage:
#   scripts/fetch-ffmpeg [--platform linux64|win64] [--dest DIR] [--keep-archive] [--force]
#
# Defaults: the platform of this machine (linux64 on Linux) and the
# development folder the locator reads in debug builds,
# <checkout>/.amp/in/ffmpeg/n8.1.3-lgpl (ignored by git; never commit it).
# For the Windows installer use `--platform win64 --dest <staging>/ffmpeg`;
# the installer copies `bin` to `<install dir>\ffmpeg\bin`.
#
# Nothing is unpacked unless the archive has the pinned size and SHA-256.
# The archive goes to a temporary folder next to DEST and is deleted after
# unpacking unless --keep-archive is given. A DEST that already holds this
# build (SELA-PIN.txt matches) is left alone unless --force.
#
# Exit codes: 0 ready, 1 download/verification/unpack failure, 2 usage.
# Policy and obligations: docs/media.md.
set -euo pipefail

TAG="autobuild-2026-09-30-13-08"
VERSION="n8.1.3-9-g29e619e767"
BASE="https://github.com/BtbN/FFmpeg-Builds/releases/download/${TAG}"
SOURCE_COMMIT="29e619e767"

platform=""
dest=""
keep=0
force=0
while [ $# -gt 0 ]; do
  case "$1" in
    --platform) platform="${2:-}"; shift 2 ;;
    --dest) dest="${2:-}"; shift 2 ;;
    --keep-archive) keep=1; shift ;;
    --force) force=1; shift ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "fetch-ffmpeg: unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$platform" ]; then
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) platform=linux64 ;;
    MINGW*|MSYS*|CYGWIN*) platform=win64 ;;
    *) echo "fetch-ffmpeg: no pinned build for $(uname -s) $(uname -m); pass --platform" >&2; exit 2 ;;
  esac
fi

case "$platform" in
  linux64)
    ASSET="ffmpeg-${VERSION}-linux64-lgpl-shared-8.1.tar.xz"
    SIZE=65590572
    SHA256="d4d7b6936f492c0b866b1cb4a29a1bbae09d6a064b4ec4eb90c95bed7969535a"
    ;;
  win64)
    ASSET="ffmpeg-${VERSION}-win64-lgpl-shared-8.1.zip"
    SIZE=80733362
    SHA256="3e47bda1607740550141e37c0e49d1e5182b34699f15adfd137ee266d346811a"
    ;;
  *) echo "fetch-ffmpeg: unknown platform '$platform' (linux64 or win64)" >&2; exit 2 ;;
esac

root="$(cd "$(dirname "$0")/.." && pwd)"
if [ -z "$dest" ]; then
  dest="$root/.amp/in/ffmpeg/n8.1.3-lgpl"
fi
case "$dest" in
  /*) ;;
  *) dest="$(pwd)/$dest" ;;
esac

pin_text() {
  printf 'source=%s\ntag=%s\nasset=%s\nsize=%s\nsha256=%s\nversion=%s\nlicense=LGPL-3.0-or-later\nsource_commit=%s (FFmpeg release/8.1)\n' \
    "$BASE/$ASSET" "$TAG" "$ASSET" "$SIZE" "$SHA256" "$VERSION" "$SOURCE_COMMIT"
}

if [ "$force" -eq 0 ] && [ -f "$dest/SELA-PIN.txt" ] && [ "$(cat "$dest/SELA-PIN.txt")" = "$(pin_text)" ]; then
  echo "fetch-ffmpeg: $dest already holds $ASSET"
  exit 0
fi

parent="$(dirname "$dest")"
mkdir -p "$parent"
work="$(mktemp -d "$parent/.fetch-ffmpeg.XXXXXX")"
cleanup() { rm -rf "$work"; }
trap cleanup EXIT

archive="$work/$ASSET"
echo "fetch-ffmpeg: downloading $BASE/$ASSET"
if ! curl --fail --location --silent --show-error --retry 3 --output "$archive" "$BASE/$ASSET"; then
  echo "fetch-ffmpeg: download failed" >&2
  exit 1
fi

actual_size="$(wc -c < "$archive" | tr -d ' ')"
if [ "$actual_size" != "$SIZE" ]; then
  echo "fetch-ffmpeg: size mismatch: expected $SIZE bytes, got $actual_size; nothing unpacked" >&2
  exit 1
fi
actual_sha="$(sha256sum "$archive" | cut -d' ' -f1)"
if [ "$actual_sha" != "$SHA256" ]; then
  echo "fetch-ffmpeg: SHA-256 mismatch: expected $SHA256, got $actual_sha; nothing unpacked" >&2
  exit 1
fi
echo "fetch-ffmpeg: size and SHA-256 verified ($SHA256)"

unpacked="$work/unpacked"
mkdir "$unpacked"
case "$ASSET" in
  *.tar.xz) tar -xJf "$archive" -C "$unpacked" ;;
  *.zip) unzip -q "$archive" -d "$unpacked" ;;
esac
top="$unpacked/${ASSET%.tar.xz}"
top="${top%.zip}"
if [ ! -d "$top/bin" ]; then
  echo "fetch-ffmpeg: unexpected archive layout (no ${top##*/}/bin)" >&2
  exit 1
fi
pin_text > "$top/SELA-PIN.txt"

if [ "$keep" -eq 1 ]; then
  mv "$archive" "$parent/$ASSET"
  echo "fetch-ffmpeg: kept $parent/$ASSET"
fi
rm -rf "$dest.old"
if [ -e "$dest" ]; then
  mv "$dest" "$dest.old"
fi
mv "$top" "$dest"
rm -rf "$dest.old"
echo "fetch-ffmpeg: unpacked $ASSET to $dest"
